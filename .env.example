# Open Resume environment example
# Copy this file to .env for local development if needed.
# Do not put real API keys in this file.

# PDF export service used by the frontend.
REACT_APP_PDF_API_URL=http://localhost:4000/api/pdf

# AI provider API keys are configured by the user in the browser AI settings.
# They are not read from this env file in the current frontend-only AI flow.
# For production or shared deployments, use a backend proxy instead of exposing
# keys in the browser.

# Optional local model example:
# Provider: Ollama local model
# Base URL: http://127.0.0.1:11434/v1
